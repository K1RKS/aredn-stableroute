#!/usr/bin/ucode
/*
 * StableRoute CGI — run /usr/bin/stableroute and stream the report.
 * Query: server=<dest>&n=<runs>&legacy=1&debug=1&format=json
 *
 * uhttpd network_timeout is ~30s idle. A background keepalive beats that while
 * a single traceroute is silent between hops (LQM stalls, long paths, etc.).
 * JSON mode waits for the full report (no progressive keepalives in the body).
 */

import * as fs from "fs";
import * as sr from "stableroute";
import * as configuration from "aredn.configuration";

const q = getenv("QUERY_STRING") || "";

const mServer = match(q, /server=([^&]*)/);
let server = mServer && mServer[1];
const mN = match(q, /n=([0-9]+)/);
let n = mN ? int(mN[1]) : 10;
const legacy = match(q, /legacy=1/) ? true : false;
const debug = match(q, /debug=1/) ? true : false;
const wantJson = match(q, /(^|&)format=json(&|$)/) ? true : false;

if (wantJson) {
    print("Content-type: application/json\r\n");
}
else {
    print("Content-type: text/html\r\n");
}
print("Cache-Control: no-store\r\n");
print("Access-Control-Allow-Origin: *\r\n");
print("\r\n");

if (!server) {
    if (wantJson) {
        print(sprintf("%J\n", {
            schemaVersion: 1,
            tool: "stableroute",
            error: "Provide a target [/cgi-bin/stableroute?server=<Target>&format=json]"
        }));
    }
    else {
        print("<html><head><title>ERROR</title></head><body><pre>Provide a target [/cgi-bin/stableroute?server=&lt;Target&gt;]</pre></body></html>\n");
    }
}
else if (match(server, /[^0-9a-zA-Z.\-]/)) {
    if (wantJson) {
        print(sprintf("%J\n", {
            schemaVersion: 1,
            tool: "stableroute",
            error: "Illegal target name"
        }));
    }
    else {
        print("<html><head><title>ERROR</title></head><body><pre>Illegal target name</pre></body></html>\n");
    }
}
else if (n < 1 || n > 100) {
    if (wantJson) {
        print(sprintf("%J\n", {
            schemaVersion: 1,
            tool: "stableroute",
            error: "n must be between 1 and 100"
        }));
    }
    else {
        print("<html><head><title>ERROR</title></head><body><pre>n must be between 1 and 100</pre></body></html>\n");
    }
}
else if (!fs.access("/usr/bin/stableroute")) {
    if (wantJson) {
        print(sprintf("%J\n", {
            schemaVersion: 1,
            tool: "stableroute",
            error: "stableroute is not installed on this node"
        }));
    }
    else {
        print("<html><head><title>ERROR</title></head><body><pre>stableroute is not installed on this node</pre></body></html>\n");
    }
}
else if (wantJson) {
    /*
     * Shell out to the CLI with -json. In-process runStableRoute under uhttpd
     * was returning an empty body (likely a ucode abort during %J / long work).
     * Keepalive beats network_timeout while probes run; filter __sr_ka__ lines.
     */
    if (!match(server, /\./) && !match(server, /^[0-9.]+$/)) {
        server += ".local.mesh";
    }
    let args = `-json -noprogress -n ${n}`;
    if (legacy) {
        args += " -legacy";
    }
    const cmd = `sh -c 'while sleep 10; do echo __sr_ka__; done & KP=$!; /usr/bin/stableroute ${args} ${server}; EC=$?; kill $KP 2>/dev/null; wait $KP 2>/dev/null; exit $EC'`;
    const running = fs.popen(`${cmd} 2>&1`);
    if (!running) {
        print(sprintf("%J\n", {
            schemaVersion: 1,
            tool: "stableroute",
            error: "stableroute failed to start"
        }));
    }
    else {
        let out = "";
        for (let line = running.read("line"); length(line); line = running.read("line")) {
            if (match(line, /__sr_ka__/)) {
                continue;
            }
            out += line;
        }
        running.close();
        out = trim(out);
        if (!out) {
            print(sprintf("%J\n", {
                schemaVersion: 1,
                tool: "stableroute",
                error: "stableroute returned no JSON"
            }));
        }
        else {
            /* Inject source if the CLI left it null. */
            let src = null;
            try {
                src = sr.shortMeshName(configuration.getName() || null);
            }
            catch (e) {
                src = null;
            }
            if (src && match(out, /"source":null/)) {
                out = replace(out, /"source":null/, `"source":${sprintf("%J", src)}`);
            }
            print(out);
            if (!match(out, /\n$/)) {
                print("\n");
            }
        }
    }
}
else {
    if (!match(server, /\./) && !match(server, /^[0-9.]+$/)) {
        server += ".local.mesh";
    }
    let args = `-progress -n ${n}`;
    if (legacy) {
        args += " -legacy";
    }
    if (debug) {
        args += " -debug";
    }
    // Keepalive every 10s while stableroute may be blocked inside one probe.
    const cmd = `sh -c 'while sleep 10; do echo __sr_ka__; done & KP=$!; /usr/bin/stableroute ${args} ${server}; EC=$?; kill $KP 2>/dev/null; wait $KP 2>/dev/null; exit $EC'`;
    const running = fs.popen(`${cmd} 2>&1`);
    if (!running) {
        print("<html><head><title>ERROR</title></head><body><pre>stableroute failed to start</pre></body></html>\n");
    }
    else {
        print("<html><head><title>SUCCESS</title></head>\n");
        // Header (Source/Target/Runs) is rendered by the Tools UI, like traceroute.
        print("<body><pre>");
        flush();
        // Line reads: non-TTY stableroute emits newline progress keepalives.
        for (let line = running.read("line"); length(line); line = running.read("line")) {
            print(line);
            flush();
        }
        running.close();
        print("</pre></body></html>\n");
    }
}
